# --- Obligatorias ---
# Cadena de conexión de Neon (Dashboard de Neon → Connection string, con ?sslmode=require)
DATABASE_URL=postgresql://usuario:clave@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
# Secreto raíz para firmar tokens y derivar claves (HKDF)
# Generala con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"  (mínimo 32 caracteres)
SESSION_SECRET=

# --- Superadmin (cuenta técnica con privilegios exclusivos) ---
# Usuario con el que ingresa (por defecto: superadmin). No puede coincidir con el correo de un agente.
SUPERADMIN_USER=superadmin
# Clave de 12+ caracteres. Si se borra, el superadmin deja de existir y su sesión se corta.
SUPERADMIN_PASSWORD=

# --- Obligatorias en producción ---
# Protege la pantalla de instalación inicial (obligatoria en Vercel; se pide una sola vez)
SETUP_KEY=
# URL pública definitiva (obligatoria en producción: passkeys, Microsoft y enlaces de los correos)
APP_URL=
# Protege /api/cron/daily (Vercel la envía sola como Bearer)
CRON_SECRET=

# --- Correo saliente (Resend) ---
RESEND_API_KEY=
MAIL_FROM=Mesa de Ayuda <ayuda@hanseatica.com>
MAIL_REPLY_TO=ayuda@hanseatica.com

# --- Correo entrante (webhook para Power Automate / Make / Zapier) ---
INBOUND_SECRET=

# --- Microsoft 365 (Entra ID, buzón, directorio, Intune, SharePoint) ---
# Tenant y Client también se pueden cargar en Configuración → Microsoft 365. El secreto va SOLO acá.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Opcional: fecha de vencimiento del secreto, para verla en Configuración (ej. 2027-10-12)
MS_CLIENT_SECRET_EXPIRES=

# --- Inteligencia artificial (copiloto y respuesta automática) ---
# Clave del proveedor elegido en Configuración → Inteligencia artificial (Anthropic, Gemini o Azure OpenAI)
AI_API_KEY=
# Solo para Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Ajustes opcionales de robustez (tienen valores por defecto) ---
# Conexiones máximas del pool por instancia, timeout por consulta (ms)
DB_POOL_MAX=5
DB_QUERY_TIMEOUT_MS=10000
# Sesiones: días de vida y horas de inactividad
SESSION_DAYS=14
SESSION_IDLE_HOURS=12
# Pedidos simultáneos por instancia y pedidos por minuto por IP (por instancia)
MAX_INFLIGHT=64
RATE_LIMIT_PER_MINUTE=600
# Pedidos por minuto para cada clave de la API de exportación (/api/v1)
API_RATE_PER_MINUTE=240
